{
  "version": 2,
  "builds": [
    {
      "src": "love-calculator/public/*",
      "use": "@vercel/static"
    },
    {
      "src": "love-calculator/api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/love-calculator/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/love-calculator/public/$1"
    }
  ]
}
